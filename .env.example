# Prisma - Supabase connection pool (runtime queries)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma - Supabase direct connection (migrations only)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase project (client-safe)
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"

# Supabase service role - server-only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# Cloudflare R2 (sheet music PDFs, cover images, audio samples)
R2_ACCOUNT_ID="[account-id]"
R2_ACCESS_KEY_ID="[access-key-id]"
R2_SECRET_ACCESS_KEY="[secret-access-key]"
R2_BUCKET_NAME="[bucket-name]"
R2_PUBLIC_URL="https://[bucket-public-hostname].r2.dev"

# Resend (order confirmation / download emails)
RESEND_API_KEY="[resend-api-key]"

# ECPay (綠界) - use the official sandbox test credentials for development:
# MerchantID 2000132, HashKey 5294y06JbISpM5x9, HashIV v77hoKGq4kWxNNIS
ECPAY_MERCHANT_ID="[merchant-id]"
ECPAY_HASH_KEY="[hash-key]"
ECPAY_HASH_IV="[hash-iv]"
ECPAY_CHECKOUT_URL="https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5"

# Public base URL - used to build ECPay's ReturnURL/ClientBackURL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
